<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row" android:layout_width="match_parent" android:layout_height="@dimen/dose_widget_row_height" android:layout_marginBottom="@dimen/dose_space_extra_small"
    android:padding="@dimen/dose_space_extra_small" android:orientation="vertical" android:background="@drawable/widget_row_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/dose_widget_row_heading" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="@dimen/dose_widget_icon" android:layout_height="@dimen/dose_widget_icon" android:contentDescription="@null"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dose_space_extra_small" android:orientation="vertical">
            <TextView android:id="@+id/medication_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/dose_text_body" android:textStyle="bold" android:textColor="@color/dose_widget_text" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/medication_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/dose_text_caption" android:textColor="@color/dose_widget_muted" android:maxLines="1" android:ellipsize="end"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/dose_widget_detail_gap">
                <TextView android:id="@+id/widget_row_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="@dimen/dose_text_label" android:textStyle="bold" android:textColor="@color/dose_widget_primary"/>
                <TextView android:id="@+id/widget_row_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dose_space_extra_small" android:textSize="@dimen/dose_text_label" android:textColor="@color/dose_widget_muted" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_actions" android:layout_width="match_parent" android:layout_height="@dimen/dose_touch_target" android:layout_marginTop="@dimen/dose_space_compact_gap" android:gravity="end" android:baselineAligned="false">
        <FrameLayout android:layout_width="wrap_content" android:layout_height="match_parent">
            <TextView android:id="@+id/take_now" android:minWidth="@dimen/dose_touch_target" android:layout_gravity="end" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="@dimen/dose_space_control_gap" android:includeFontPadding="false" android:textSize="@dimen/dose_text_label" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/dose_widget_on_primary" android:background="@drawable/notification_action_primary"/>
        </FrameLayout>
        <FrameLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="@dimen/dose_space_compact_gap">
            <TextView android:id="@+id/skip" android:minWidth="@dimen/dose_touch_target" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="@dimen/dose_space_control_gap" android:includeFontPadding="false" android:textSize="@dimen/dose_text_label" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="@color/dose_widget_on_primary_container" android:background="@drawable/notification_action_secondary"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
