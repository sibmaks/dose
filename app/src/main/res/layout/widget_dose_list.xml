<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_list_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="@dimen/dose_space_small" android:background="@drawable/widget_list_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="@dimen/dose_widget_list_header" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="@color/dose_widget_text" android:textSize="@dimen/dose_text_body" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dose_space_extra_small" android:textColor="@color/dose_widget_primary" android:textSize="@dimen/dose_text_detail" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_empty_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:padding="@dimen/dose_space_extra_small" android:visibility="gone" android:textColor="@color/dose_widget_text" android:textSize="@dimen/dose_text_emphasis" android:textStyle="bold" />
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/widget_dose" android:layout_width="match_parent" android:layout_height="@dimen/dose_widget_footer" android:gravity="center_vertical"
        android:textColor="@color/dose_widget_primary" android:textSize="@dimen/dose_text_caption" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
