<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="#FFFFFF">
    <TextView android:id="@+id/medication_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="#252B43" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/medication_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#6F748B" android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/group_actions" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/take_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginStart="0dp" android:padding="8dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:background="@drawable/notification_action_primary"/>
        <TextView android:id="@+id/skip_all" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginStart="8dp" android:padding="8dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#5141BE" android:background="@drawable/notification_action_secondary"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/acceptance_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/take_now" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginStart="0dp" android:padding="8dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:background="@drawable/notification_action_primary"/>
        <TextView android:id="@+id/take_on_time" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginStart="8dp" android:padding="8dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#5141BE" android:background="@drawable/notification_action_secondary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/snooze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginStart="0dp" android:padding="8dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#5141BE" android:background="@drawable/notification_action_secondary"/>
        <TextView android:id="@+id/skip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="40dp" android:layout_marginStart="8dp" android:padding="8dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textColor="#5141BE" android:background="@drawable/notification_action_secondary"/>
    </LinearLayout>
</LinearLayout>
