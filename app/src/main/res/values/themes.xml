<resources>
    <style name="Theme.Dose" parent="Theme.Dose.Light" />
    <style name="Theme.Dose.Light" parent="Theme.Dose.Base.Light" />
    <style name="Theme.Dose.Dark" parent="Theme.Dose.Base.Dark" />
    <style name="Theme.Dose.Base.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dose_page_light</item>
        <item name="android:statusBarColor">@color/dose_page_light</item>
        <item name="android:navigationBarColor">@color/dose_panel_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/dose_primary</item>
    </style>
    <style name="Theme.Dose.Base.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dose_page_dark</item>
        <item name="android:statusBarColor">@color/dose_page_dark</item>
        <item name="android:navigationBarColor">@color/dose_panel_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/dose_primary_dark</item>
    </style>
    <style name="Theme.Dose.Dialog.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/dose_primary</item>
    </style>
    <style name="Theme.Dose.Dialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/dose_primary_dark</item>
    </style>
</resources>
